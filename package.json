    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "openai": "^4.33.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "uuid": "^9.0.1"
